// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(cuid())
  email                String?              @unique
  githubId             String?              @unique
  name                 String?
  avatarUrl            String?
  projects             Project[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  sessions             Session[]
  installations        GithubInstallation[]
  deploymentActivities DeploymentActivity[]
}
enum DeploymentLogSource {
  BUILD
  RUNTIME
}
model Deployment {
  id                   String               @id @default(cuid())
  projectId            String
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch               String
  commitSha            String
  dockerfilePath       String?
  buildStrategy        BuildStrategy        @default(DOCKERFILE)
  status               DeploymentStatus     @default(PENDING)
  imageTag             String?
  containerName        String?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  activities           DeploymentActivity[]
  hostPort             Int?
  containerPort        Int?
  localUrl             String?
  previewScreenshotUrl String?
  supersededAt         DateTime?
  stoppedAt            DateTime?
  logs DeploymentLog[]

  @@index([projectId, createdAt])
  @@index([status])
}

enum DeploymentActivityType {
  DEPLOYMENT_CREATED
  STATUS_CHANGED
  BUILD_STARTED
  BUILD_COMPLETED
  BUILD_FAILED
}

model GithubInstallation {
  id             String    @id @default(cuid())
  installationId String    @unique
  accountId      String
  accountLogin   String
  accountType    String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projects       Project[]

  @@index([userId])
}

enum DeploymentStatus {
  PENDING
  QUEUED
  BUILDING
  READY
  FAILED
  CANCELLED
}

model DeploymentActivity {
  id           String                 @id @default(cuid())
  deploymentId String
  deployment   Deployment             @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  actorUserId  String?
  actorUser    User?                  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  type         DeploymentActivityType
  fromStatus   DeploymentStatus?
  toStatus     DeploymentStatus?
  message      String
  metadata     Json?
  createdAt    DateTime               @default(now())

  @@index([deploymentId, createdAt])
  @@index([actorUserId])
}
model DeploymentLog {
  id           String              @id @default(cuid())
  deploymentId String
  deployment   Deployment          @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  source       DeploymentLogSource
  message      String
  createdAt    DateTime            @default(now())

  @@index([deploymentId, createdAt])
}

 enum BuildStrategy {
    DOCKERFILE
    NODE_FRONTEND
    NODE_BACKEND
  }
model Project {
  id                       String              @id @default(cuid())
  name                     String
  repositoryUrl            String?
  branch                   String              @default("main")
  userId                   String
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  githubInstallationId     String?
  githubInstallation       GithubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  githubRepositoryId       String?
  githubRepositoryFullName String?
  buildStrategy            BuildStrategy       @default(DOCKERFILE)
  deployments              Deployment[]
  environmentVariables     EnvironmentVariable[]
  @@index([githubInstallationId, githubRepositoryId])
  @@index([userId])
}
model EnvironmentVariable {
    id             String   @id @default(cuid())
    projectId      String
    project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    key            String
    encryptedValue String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@unique([projectId, key])
    @@index([projectId])
  }
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
